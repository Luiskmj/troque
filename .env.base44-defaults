# Base44 development defaults — placeholders so the app boots without real credentials.
# Real secrets are delivered via /run/base44/app.env and override these.

AUTH_SECRET=base44-dev-auth-secret-placeholder
API_SECRET=base44-dev-api-secret-placeholder
ADMINS=1

# Nuvemshop (external — replace via dashboard)
APP_ID=base44-dev-placeholder
APP_SECRET=base44-dev-placeholder

# Email SMTP (external — replace via dashboard)
SMPT_USER=base44-dev-placeholder
SMPT_PASSWORD=base44-dev-placeholder

# Vindi payments (external — replace via dashboard)
VINDI_URL=https://app.vindi.com.br/api/v1
VINDI_USERNAME=base44-dev-placeholder
VINDI_PASSWORD=base44-dev-placeholder

# Frontend URL for CORS/redirects
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:3000
API_URL=http://localhost:3000
