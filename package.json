{
  "name": "argon-dashboard-react",
  "version": "1.0.0",
  "description": "Dashboard Troque Rapido",
  "main": "index.js",
  "keywords": [
    "react",
    "reactjs"
  ],
  "author": "Agencia Eva",
  "license": "MIT",
  "homepage": "/",
  "scripts": {
    "start": "concurrently \"set PORT=3012 && react-scripts --openssl-legacy-provider start\" \"npm run tailwind:watch\"",
    "start-senai": "concurrently \"set PORT=3000 && react-scripts start\" \"npm run tailwind:watch\"",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "tailwind:watch": "tailwind -i ./src/assets/tailwind/tailwind.config.css -o ./src/assets/tailwind/tailwind.css --watch",
    "install:clean": "rm -rf node_modules/ && rm -rf package-lock.json && npm install && npm start",
    "compile-sass": "node-sass src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.css",
    "minify-sass": "node-sass src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.min.css --output-style compressed",
    "map-sass": "node-sass src/assets/scss/argon-dashboard-react.scss src/assets/css/argon-dashboard-react.css --source-map true"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
